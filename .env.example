# Splunk MCP Integration Platform - Environment Configuration Template
# ========================================================================
# Copy this file to .env and configure with your specific values
# For security, never commit .env files to version control

# ========================================================================
# ENVIRONMENT SETTINGS
# ========================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ========================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ========================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=splunk_mcp
POSTGRES_USER=splunk_mcp_user
POSTGRES_PASSWORD=change_this_secure_password

# Complete database URL (auto-generated if not provided)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ========================================================================
# CACHE CONFIGURATION (Redis)
# ========================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password
REDIS_DB=0

# Complete Redis URL (auto-generated if not provided)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ========================================================================
# SPLUNK CONFIGURATION
# ========================================================================
SPLUNK_HOST=your-splunk-server.com
SPLUNK_PORT=8089
SPLUNK_SCHEME=https
SPLUNK_USERNAME=splunk_mcp_service
SPLUNK_PASSWORD=your_splunk_password

# Splunk connection settings
SPLUNK_VERIFY_SSL=true
SPLUNK_TIMEOUT=30
SPLUNK_MAX_RETRIES=3

# Default Splunk settings
SPLUNK_DEFAULT_INDEX=main
SPLUNK_MAX_SEARCH_TIME=300
SPLUNK_MAX_RESULTS=10000

# ========================================================================
# AI/ML SERVICE API KEYS
# ========================================================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.1

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=2048

# ========================================================================
# JWT AUTHENTICATION CONFIGURATION
# ========================================================================
JWT_SECRET_KEY=your-generated-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_ISSUER=splunk-mcp-platform
JWT_AUDIENCE=splunk-mcp-users

# ========================================================================
# SERVICE PORT CONFIGURATION
# ========================================================================
API_GATEWAY_PORT=8000
NLP_ENGINE_PORT=8001
VISUALIZATION_PORT=8002
ALERT_MANAGER_PORT=8003
SLACK_BOT_PORT=8004
TEAMS_BOT_PORT=8005
EMAIL_SERVICE_PORT=8006
WEBHOOK_SERVICE_PORT=8007
BI_INTEGRATION_PORT=8008
PDF_EXPORT_PORT=8009
POWERPOINT_EXPORT_PORT=8011
HTML_REPORT_PORT=8012
WORD_EXPORT_PORT=8013
CSV_EXPORT_PORT=8014
JSON_XML_EXPORT_PORT=8015
SECURE_SHARING_PORT=8016
FRONTEND_PORT=3000

# ========================================================================
# INTEGRATION SERVICES CONFIGURATION
# ========================================================================

# Slack Bot Configuration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here
SLACK_APP_TOKEN=xapp-your-slack-app-token-here

# Microsoft Teams Bot Configuration
TEAMS_APP_ID=your-azure-app-id
TEAMS_APP_PASSWORD=your-azure-app-password
TEAMS_TENANT_ID=your-azure-tenant-id

# Email Service Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_USE_TLS=true
SMTP_FROM_NAME=Splunk MCP Platform
SMTP_FROM_EMAIL=noreply@yourcompany.com
LOG_LEVEL=INFO

# Security Configuration
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=10

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS_PER_USER=5

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=csv,json,txt

# Monitoring & Observability
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
JAEGER_ENABLED=false

# External Services
VAULT_URL=http://localhost:8200
VAULT_TOKEN=your-vault-token

# Development Tools
PGADMIN_DEFAULT_EMAIL=admin@splunk-mcp.local
PGADMIN_DEFAULT_PASSWORD=admin