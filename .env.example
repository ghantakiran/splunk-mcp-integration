# Splunk MCP Integration Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://splunk_mcp_user:splunk_mcp_password@localhost:5432/splunk_mcp
POSTGRES_DB=splunk_mcp
POSTGRES_USER=splunk_mcp_user
POSTGRES_PASSWORD=splunk_mcp_password

# Redis Configuration
REDIS_URL=redis://:redis_password@localhost:6379/0
REDIS_PASSWORD=redis_password

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
JWT_REFRESH_EXPIRE_DAYS_EXTENDED=30

# Authentication Configuration
REGISTRATION_ENABLED=true

# API Keys for NLP Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Splunk Configuration
SPLUNK_HOST=https://your-splunk-instance.com:8089
SPLUNK_TOKEN=your-splunk-token
SPLUNK_USERNAME=your-splunk-username
SPLUNK_PASSWORD=your-splunk-password

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_SSL=false

# Notification Services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK

# Application Configuration
APP_NAME=Splunk MCP Integration
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security Configuration
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=10

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS_PER_USER=5

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=csv,json,txt

# Monitoring & Observability
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
JAEGER_ENABLED=false

# External Services
VAULT_URL=http://localhost:8200
VAULT_TOKEN=your-vault-token

# Development Tools
PGADMIN_DEFAULT_EMAIL=admin@splunk-mcp.local
PGADMIN_DEFAULT_PASSWORD=admin