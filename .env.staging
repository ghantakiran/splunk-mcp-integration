# Staging Environment Configuration
# ==================================
# This file contains staging-specific settings
# Used for pre-production testing and validation

# Environment Settings
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration (Staging)
POSTGRES_HOST=staging-postgres.company.com
POSTGRES_PORT=5432
POSTGRES_DB=splunk_mcp_staging
POSTGRES_USER=splunk_mcp_staging_user
POSTGRES_PASSWORD=staging_secure_password_change_me
DATABASE_URL=postgresql://splunk_mcp_staging_user:staging_secure_password_change_me@staging-postgres.company.com:5432/splunk_mcp_staging

# Redis Configuration (Staging)
REDIS_HOST=staging-redis.company.com
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password_change_me
REDIS_DB=0
REDIS_URL=redis://:staging_redis_password_change_me@staging-redis.company.com:6379/0

# JWT Configuration (Staging)
JWT_SECRET_KEY=staging-jwt-secret-key-generate-secure-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=2
JWT_REFRESH_EXPIRATION_DAYS=14

# AI/ML API Keys (Staging)
OPENAI_API_KEY=sk-staging-openai-api-key-here
ANTHROPIC_API_KEY=staging-anthropic-api-key-here
OPENAI_MODEL=gpt-4
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Splunk Configuration (Staging)
SPLUNK_HOST=staging-splunk.company.com
SPLUNK_PORT=8089
SPLUNK_SCHEME=https
SPLUNK_USERNAME=staging_splunk_user
SPLUNK_PASSWORD=staging_splunk_password
SPLUNK_VERIFY_SSL=true
SPLUNK_DEFAULT_INDEX=staging_main

# Service Ports (Staging)
API_GATEWAY_PORT=8000
NLP_ENGINE_PORT=8001
VISUALIZATION_PORT=8002
ALERT_MANAGER_PORT=8003
FRONTEND_PORT=3000

# Integration Services (Staging)
SLACK_BOT_TOKEN=xoxb-staging-slack-bot-token
SLACK_SIGNING_SECRET=staging-slack-signing-secret
TEAMS_APP_ID=staging-teams-app-id
TEAMS_APP_PASSWORD=staging-teams-app-password

# SMTP Configuration (Staging)
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=staging-noreply@company.com
SMTP_PASSWORD=staging_smtp_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=staging-noreply@company.com
SMTP_FROM_NAME=Splunk MCP Staging

# Security (Production-like)
CORS_ORIGINS=["https://staging.company.com", "https://staging-api.company.com"]
FORCE_HTTPS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=500

# Performance (Staging)
MAX_WORKERS=4
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=20
REDIS_MAX_CONNECTIONS=50

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7

# Feature Flags (Staging)
FEATURE_SLACK_INTEGRATION=true
FEATURE_TEAMS_INTEGRATION=true
FEATURE_EMAIL_INTEGRATION=true
EXPERIMENTAL_AI_SUGGESTIONS=true

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/staging.crt
SSL_KEY_PATH=/etc/ssl/private/staging.key