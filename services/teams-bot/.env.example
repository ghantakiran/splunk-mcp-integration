# Environment Configuration for Microsoft Teams Bot Service

# Application settings
ENVIRONMENT=development
TEAMS_BOT_PORT=8005
LOG_LEVEL=INFO

# Microsoft Teams Bot Framework configuration
MICROSOFT_APP_ID=your-microsoft-app-id-here
MICROSOFT_APP_PASSWORD=your-microsoft-app-password-here
MICROSOFT_APP_TENANT_ID=your-tenant-id-here

# Bot Framework settings
BOT_FRAMEWORK_URL=https://smba.trafficmanager.net/teams/
BOT_FRAMEWORK_TIMEOUT=30

# Backend service URLs
API_GATEWAY_URL=http://localhost:8000
NLP_ENGINE_URL=http://localhost:8001
VISUALIZATION_URL=http://localhost:8002
ALERT_MANAGER_URL=http://localhost:8003

# Service timeouts (seconds)
API_GATEWAY_TIMEOUT=30
NLP_ENGINE_TIMEOUT=60
VISUALIZATION_TIMEOUT=45
ALERT_MANAGER_TIMEOUT=30

# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/teams_bot

# Redis configuration
REDIS_URL=redis://localhost:6379/4
REDIS_TIMEOUT=5

# Security settings
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Teams bot settings
MAX_MESSAGE_LENGTH=28000
MAX_QUERY_RESULTS=50
ENABLE_PROACTIVE_MESSAGES=true
ENABLE_ADAPTIVE_CARDS=true
ENABLE_TASK_MODULES=true

# Teams features
ENABLE_MENTIONS=true
ENABLE_CHANNEL_MESSAGES=true
ENABLE_PERSONAL_CHAT=true
ENABLE_GROUP_CHAT=true

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9005

# Teams app settings
TEAMS_APP_NAME=Splunk MCP Assistant
TEAMS_APP_DESCRIPTION=Natural language interface for Splunk data queries and analysis

# Supported activity types (comma-separated)
SUPPORTED_ACTIVITY_TYPES=message,invoke,memberAdded,installationUpdate