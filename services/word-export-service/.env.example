# Word Export Service Environment Configuration

# Basic settings
DEBUG=false
API_PORT=8013
API_HOST=0.0.0.0

# Database settings
DATABASE_URL=postgresql://wordservice:wordservice@localhost:5432/wordservice
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30

# Redis settings
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Authentication settings
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Word generation settings
WORD_OUTPUT_DIR=/tmp/word-exports
WORD_TEMPLATE_DIR=app/templates
WORD_MAX_FILE_SIZE_MB=50
WORD_TIMEOUT_SECONDS=300
WORD_CONCURRENT_JOBS=5

# Chart integration settings
CHART_SERVICE_URL=http://localhost:8002
CHART_TIMEOUT_SECONDS=30
CHART_MAX_WIDTH=1920
CHART_MAX_HEIGHT=1080
CHART_FORMAT=png
CHART_DPI=300

# Document settings
ENABLE_CHARTS=true
ENABLE_TABLES=true
ENABLE_IMAGES=true
ENABLE_WATERMARK=true
ENABLE_HEADERS_FOOTERS=true

# Template settings
DEFAULT_TEMPLATE=professional
AVAILABLE_TEMPLATES=["professional","corporate","academic","report","minimal"]

# Export settings
EXPORT_FORMATS=["docx"]
DEFAULT_EXPORT_FORMAT=docx

# Performance settings
MAX_CONCURRENT_JOBS=10
JOB_QUEUE_SIZE=1000
WORKER_TIMEOUT=300

# Rate limiting settings
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=15

# File cleanup settings
CLEANUP_OLDER_THAN_DAYS=7
CLEANUP_INTERVAL_HOURS=24

# Logging settings
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# Document library settings
ENABLE_PYTHON_DOCX=true
ENABLE_DOCX_TEMPLATE=true

# Security settings
ENABLE_CONTENT_FILTERING=true
MAX_DOCUMENT_PAGES=1000
ALLOWED_DOMAINS=[]

# Monitoring settings
ENABLE_METRICS=true
METRICS_PORT=9013