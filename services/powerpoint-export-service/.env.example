# PowerPoint Export Service Environment Configuration

# Basic settings
DEBUG=false
API_PORT=8011
API_HOST=0.0.0.0

# Database settings
DATABASE_URL=postgresql://pptservice:pptservice@localhost:5432/pptservice
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30

# Redis settings
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Authentication settings
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# PowerPoint generation settings
PPT_OUTPUT_DIR=/tmp/ppt-exports
PPT_TEMPLATE_DIR=app/templates
PPT_MAX_FILE_SIZE_MB=200
PPT_MAX_SLIDES=100
PPT_TIMEOUT_SECONDS=600
PPT_CONCURRENT_JOBS=5

# Chart integration settings
CHART_SERVICE_URL=http://localhost:8002
CHART_TIMEOUT_SECONDS=30
CHART_MAX_WIDTH=1920
CHART_MAX_HEIGHT=1080
CHART_FORMAT=png
CHART_DPI=300

# Slide layout settings
SLIDE_WIDTH=10
SLIDE_HEIGHT=7.5
SLIDE_MARGIN=0.5

# Theme settings
DEFAULT_THEME=office
AVAILABLE_THEMES=office,modern,colorful,dark,minimal

# Animation settings
ENABLE_ANIMATIONS=true
DEFAULT_ANIMATION=fade
AVAILABLE_ANIMATIONS=fade,slide,zoom,flip,none

# Transition settings
ENABLE_TRANSITIONS=true
DEFAULT_TRANSITION=fade
AVAILABLE_TRANSITIONS=fade,slide,push,cover,uncover,none

# Rate limiting settings
RATE_LIMIT_REQUESTS_PER_MINUTE=50
RATE_LIMIT_BURST=10

# File cleanup settings
CLEANUP_OLDER_THAN_DAYS=7
CLEANUP_INTERVAL_HOURS=24

# Logging settings
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# Performance settings
MAX_CONCURRENT_JOBS=10
JOB_QUEUE_SIZE=1000
WORKER_TIMEOUT=300

# Font settings
DEFAULT_FONT_FAMILY=Calibri
DEFAULT_FONT_SIZE=18
AVAILABLE_FONTS=Calibri,Arial,Times New Roman,Helvetica,Georgia

# Color scheme settings
DEFAULT_COLOR_SCHEME=blue
AVAILABLE_COLOR_SCHEMES=blue,red,green,orange,purple,teal

# Template settings
ENABLE_CUSTOM_TEMPLATES=true
MAX_TEMPLATE_SIZE_MB=50
TEMPLATE_CACHE_TTL=3600

# Export settings
EXPORT_FORMATS=pptx,pdf,png,jpg
DEFAULT_EXPORT_FORMAT=pptx

# Security settings
ENABLE_CONTENT_FILTERING=true
MAX_TEXT_LENGTH=10000
ALLOWED_IMAGE_FORMATS=png,jpg,jpeg,gif,bmp

# Monitoring settings
ENABLE_METRICS=true
METRICS_PORT=9011
