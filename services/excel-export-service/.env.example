# Excel Export Service Environment Configuration

# Basic settings
DEBUG=false
API_PORT=8010

# Database settings
DATABASE_URL=postgresql://excelservice:excelservice@localhost:5432/excelservice

# Redis settings
REDIS_URL=redis://localhost:6379

# Authentication settings
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Excel generation settings
EXCEL_OUTPUT_DIR=/tmp/excel-exports
EXCEL_TEMPLATE_DIR=app/templates
EXCEL_MAX_FILE_SIZE_MB=100
EXCEL_MAX_ROWS=1000000
EXCEL_MAX_COLUMNS=16384
EXCEL_TIMEOUT_SECONDS=300

# Chart integration settings
CHART_SERVICE_URL=http://localhost:8002
CHART_TIMEOUT_SECONDS=30
CHART_MAX_WIDTH=1200
CHART_MAX_HEIGHT=800
CHART_FORMAT=png

# Rate limiting settings
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=10

# File cleanup settings
CLEANUP_OLDER_THAN_DAYS=7
CLEANUP_INTERVAL_HOURS=24

# Logging settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# Performance settings
MAX_CONCURRENT_JOBS=10
JOB_QUEUE_SIZE=1000

# Theme settings
DEFAULT_THEME=office
AVAILABLE_THEMES=office,modern,colorful,dark,light

# Data validation settings
ENABLE_DATA_VALIDATION=true
MAX_VALIDATION_RULES=100

# Formula settings
ENABLE_FORMULAS=true
SAFE_FORMULA_FUNCTIONS=SUM,AVERAGE,COUNT,MAX,MIN,IF,VLOOKUP,HLOOKUP