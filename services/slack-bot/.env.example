# Environment Configuration for Slack Bot Service

# Application settings
ENVIRONMENT=development
SLACK_BOT_PORT=8004
LOG_LEVEL=INFO

# Slack configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Backend service URLs
API_GATEWAY_URL=http://localhost:8000
NLP_ENGINE_URL=http://localhost:8001
VISUALIZATION_URL=http://localhost:8002
ALERT_MANAGER_URL=http://localhost:8003

# Service timeouts (seconds)
API_GATEWAY_TIMEOUT=30
NLP_ENGINE_TIMEOUT=60
VISUALIZATION_TIMEOUT=45
ALERT_MANAGER_TIMEOUT=30

# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/slack_bot

# Redis configuration
REDIS_URL=redis://localhost:6379/3
REDIS_TIMEOUT=5

# Security settings
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Slack bot settings
MAX_MESSAGE_LENGTH=3000
MAX_QUERY_RESULTS=50
ENABLE_DIRECT_MESSAGES=true
ENABLE_CHANNEL_MENTIONS=true
ENABLE_SLASH_COMMANDS=true

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9004