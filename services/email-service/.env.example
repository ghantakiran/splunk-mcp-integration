# Email Service Configuration

# Application settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8006
LOG_LEVEL=INFO

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30

# Email settings
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Splunk MCP Assistant
REPLY_TO_EMAIL=noreply@your-domain.com
MAX_ATTACHMENT_SIZE=26214400  # 25MB
ALLOWED_ATTACHMENT_TYPES=pdf,xlsx,csv,png,jpg,html

# IMAP Configuration (optional for email processing)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX

# Backend Service URLs
API_GATEWAY_URL=http://localhost:8000
NLP_ENGINE_URL=http://localhost:8001
VISUALIZATION_URL=http://localhost:8002
ALERT_MANAGER_URL=http://localhost:8003

# Service timeouts (seconds)
API_TIMEOUT=30
NLP_TIMEOUT=60
VISUALIZATION_TIMEOUT=45
ALERT_TIMEOUT=30

# Database Configuration
DATABASE_URL=postgresql://email_user:email_pass@localhost:5432/email_service
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis Configuration
REDIS_URL=redis://localhost:6379/5
REDIS_TIMEOUT=5

# Security Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Email Processing Settings
MAX_EMAIL_SIZE=52428800  # 50MB
MAX_QUERY_LENGTH=10000
MAX_RESULTS_PER_EMAIL=1000
EMAIL_CHECK_INTERVAL=60

# Template Settings
TEMPLATE_DIRECTORY=app/templates
DEFAULT_TEMPLATE=default.html

# Report Settings
REPORT_TIMEOUT=300
MAX_REPORT_SIZE=104857600  # 100MB
SUPPORTED_FORMATS=html,pdf,csv,xlsx

# Rate Limiting
RATE_LIMIT_PER_USER=100
RATE_LIMIT_PER_DOMAIN=500
RATE_LIMIT_WINDOW=3600

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9006

# Feature Flags
ENABLE_IMAP_PROCESSING=false
ENABLE_ATTACHMENTS=true
ENABLE_HTML_EMAILS=true
ENABLE_EMAIL_THREADING=true
ENABLE_AUTO_RESPONSES=true

# Security Whitelist/Blacklist (comma-separated)
# ALLOWED_DOMAINS=company.com,trusted-domain.com
# BLOCKED_DOMAINS=spam-domain.com
# ALLOWED_USERS=user1@company.com,user2@company.com
# BLOCKED_USERS=blocked@domain.com