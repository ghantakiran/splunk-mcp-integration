# ITSM Service Environment Configuration

# Database Configuration
DATABASE_URL=postgresql+asyncpg://itsm_user:itsm_password@localhost:5435/itsm_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6382/3
REDIS_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW=3600
RATE_LIMIT_BURST_LIMIT=50

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# Development Configuration
DEBUG=false
ENVIRONMENT=development
API_VERSION=v1

# External Service Timeouts
HTTP_TIMEOUT=30
CONNECTION_TIMEOUT=10
READ_TIMEOUT=30

# ServiceNow Configuration (Optional defaults)
SERVICENOW_DEFAULT_TIMEOUT=30
SERVICENOW_MAX_RETRIES=3
SERVICENOW_BATCH_SIZE=100

# Jira Configuration (Optional defaults)
JIRA_DEFAULT_TIMEOUT=30
JIRA_MAX_RETRIES=3
JIRA_BATCH_SIZE=100

# Sync Configuration
SYNC_DEFAULT_INTERVAL=900  # 15 minutes
SYNC_MAX_CONCURRENT=5
SYNC_BATCH_SIZE=100
SYNC_TIMEOUT=300

# Workflow Configuration
WORKFLOW_MAX_CONCURRENT=10
WORKFLOW_DEFAULT_TIMEOUT=1800  # 30 minutes
WORKFLOW_MAX_STEPS=100

# Security Configuration
SECURE_COOKIES=true
SECURE_HEADERS=true
CSRF_PROTECTION=true

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30
METRICS_COLLECTION_INTERVAL=60