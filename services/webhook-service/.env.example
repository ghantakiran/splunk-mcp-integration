# Webhook Service Environment Configuration
# Copy this file to .env and update the values for your environment

# Application settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8007

# Database configuration
DATABASE_URL=postgresql+asyncpg://webhook:webhook123@localhost:5438/webhook_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis configuration  
REDIS_URL=redis://localhost:6380/0
REDIS_TIMEOUT=5

# Service URLs (update these to match your environment)
API_GATEWAY_URL=http://localhost:8000
NLP_ENGINE_URL=http://localhost:8001
VISUALIZATION_URL=http://localhost:8002
ALERT_MANAGER_URL=http://localhost:8003
EMAIL_SERVICE_URL=http://localhost:8006

# Service timeouts
API_TIMEOUT=30
WEBHOOK_TIMEOUT=30
DELIVERY_TIMEOUT=60

# JWT configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Webhook settings
MAX_WEBHOOK_PAYLOAD_SIZE=10485760  # 10MB
MAX_WEBHOOKS_PER_USER=50
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=300
WEBHOOK_DELIVERY_TIMEOUT=30

# Event processing settings
MAX_EVENTS_PER_MINUTE=1000
EVENT_BATCH_SIZE=100
EVENT_PROCESSING_INTERVAL=10
EVENT_RETENTION_DAYS=30

# Delivery settings
MAX_CONCURRENT_DELIVERIES=50
DELIVERY_RETRY_EXPONENTIAL_BASE=2.0
DELIVERY_RETRY_MAX_DELAY=3600
DELIVERY_QUEUE_SIZE=10000

# Rate limiting
RATE_LIMIT_PER_USER=1000
RATE_LIMIT_PER_ENDPOINT=500
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_BURST=10

# Monitoring settings
ENABLE_METRICS=true
METRICS_PORT=9007

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# Feature flags
ENABLE_SIGNATURE_VERIFICATION=true
ENABLE_PAYLOAD_COMPRESSION=false
ENABLE_DELIVERY_TRACKING=true
ENABLE_EVENT_FILTERING=true
ENABLE_ANALYTICS=true

# Security whitelist/blacklist (comma-separated)
ALLOWED_WEBHOOK_DOMAINS=
BLOCKED_WEBHOOK_DOMAINS=
ALLOWED_USER_AGENTS=
BLOCKED_USER_AGENTS=

# HTTP client settings
HTTP_CLIENT_TIMEOUT=30
HTTP_CLIENT_MAX_CONNECTIONS=100
HTTP_CLIENT_MAX_KEEPALIVE=20
HTTP_CLIENT_KEEPALIVE_EXPIRY=5

# Background task settings
BACKGROUND_TASK_INTERVAL=60
CLEANUP_TASK_INTERVAL=3600
METRICS_COLLECTION_INTERVAL=300

# Event types configuration (comma-separated)
SUPPORTED_EVENT_TYPES=query.completed,alert.triggered,dashboard.created,report.generated,error.occurred,system.status_changed,user.action,data.updated

# Webhook endpoint validation (comma-separated)
WEBHOOK_URL_SCHEMES=http,https
WEBHOOK_REQUIRED_HEADERS=User-Agent,Content-Type