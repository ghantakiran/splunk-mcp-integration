# PDF Export Service Environment Variables

# Application
DEBUG=true
ENVIRONMENT=development
APP_NAME="PDF Export Service"
APP_VERSION="1.0.0"

# API
API_PORT=8009
API_VERSION=v1
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://pdfservice:pdfservice@localhost:5432/pdfservice
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8009
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW=3600
RATE_LIMIT_BURST_LIMIT=50

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9009

# PDF Generation
PDF_OUTPUT_DIR=/tmp/pdf-exports
PDF_TEMPLATE_DIR=app/templates
PDF_MAX_FILE_SIZE_MB=100
PDF_MAX_PAGES=1000
PDF_TIMEOUT_SECONDS=300
PDF_DPI=300
PDF_QUALITY=high

# Chart Integration
CHART_SERVICE_URL=http://localhost:8002
CHART_TIMEOUT_SECONDS=30
CHART_MAX_WIDTH=1200
CHART_MAX_HEIGHT=800
CHART_FORMAT=png

# Template Engine
TEMPLATE_ENGINE=jinja2
TEMPLATE_CACHE_SIZE=100
TEMPLATE_CACHE_TTL=3600

# File Storage
TEMP_DIR=/tmp/pdf-export
MAX_FILE_SIZE_MB=500
CLEANUP_INTERVAL_HOURS=24
STORAGE_RETENTION_DAYS=7

# Security
ENCRYPTION_KEY=your-encryption-key-here
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT=3600
MAX_CONCURRENT_GENERATIONS=10

# Background Jobs
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/5

# WeasyPrint Configuration
WEASYPRINT_BASE_URL=/
WEASYPRINT_PRESENTATIONAL_HINTS=true
WEASYPRINT_OPTIMIZE_IMAGES=true

# Font Configuration
FONT_DIRECTORY=/usr/share/fonts
CUSTOM_FONTS_DIR=/app/fonts

# Performance Tuning
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=120
KEEPALIVE_TIMEOUT=65

# Monitoring
ENABLE_PROMETHEUS=true
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30

# Development
RELOAD_ON_CHANGE=true
DEBUG_SQL=false
PROFILING_ENABLED=false