# NLP Engine Service Environment Configuration

# Application Settings
APP_NAME=splunk-mcp-nlp-engine
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8001

# API Configuration
API_V1_PREFIX=/api/v1
OPENAPI_URL=/api/v1/openapi.json

# AI/ML Service Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT=30

# Anthropic Configuration (Alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.1

# NLP Configuration
DEFAULT_AI_PROVIDER=openai
ENABLE_CONTEXT_MEMORY=true
MAX_CONTEXT_LENGTH=8192
CONVERSATION_TIMEOUT=1800

# Database Configuration
DATABASE_URL=postgresql+asyncpg://nlp_user:nlp_password@localhost:5432/splunk_mcp_nlp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/2
REDIS_PASSWORD=
REDIS_DB=2
REDIS_MAX_CONNECTIONS=20

# Security Configuration
SECRET_KEY=your_super_secret_key_here_change_in_production
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Monitoring and Logging
ENABLE_METRICS=true
METRICS_PORT=9090
STRUCTURED_LOGGING=true
LOG_JSON_FORMAT=true

# Rate Limiting
RATE_LIMITING_ENABLED=true
DEFAULT_RATE_LIMIT=100
RATE_LIMIT_WINDOW=3600

# Splunk Integration
SPLUNK_API_BASE_URL=https://your-splunk-instance:8089
SPLUNK_API_TOKEN=your_splunk_api_token
SPLUNK_VERIFY_SSL=true
SPLUNK_TIMEOUT=30

# Performance Configuration
WORKER_PROCESSES=1
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=120
ENABLE_ASYNC_PROCESSING=true

# Development Settings
RELOAD_ON_CHANGE=true
ENABLE_DEBUG_ENDPOINTS=true
MOCK_AI_RESPONSES=false