# BI Integration Service Environment Variables

# Application
DEBUG=true
ENVIRONMENT=development
APP_NAME="BI Integration Service"
APP_VERSION="1.0.0"

# API
API_VERSION=v1
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://biservice:biservice@localhost:5432/biservice
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8008
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW=3600
RATE_LIMIT_BURST_LIMIT=50

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9008

# Tableau Configuration
TABLEAU_SERVER_URL=https://your-tableau-server.com
TABLEAU_SITE_ID=your-site-id
TABLEAU_USERNAME=your-username
TABLEAU_PASSWORD=your-password
TABLEAU_TOKEN_NAME=your-token-name
TABLEAU_TOKEN_VALUE=your-token-value
TABLEAU_API_VERSION=3.19
TABLEAU_TIMEOUT=300
TABLEAU_MAX_RETRIES=3
TABLEAU_BATCH_SIZE=100

# Power BI Configuration
POWERBI_TENANT_ID=your-tenant-id
POWERBI_CLIENT_ID=your-client-id
POWERBI_CLIENT_SECRET=your-client-secret
POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default
POWERBI_AUTHORITY=https://login.microsoftonline.com/
POWERBI_API_URL=https://api.powerbi.com/
POWERBI_TIMEOUT=300
POWERBI_MAX_RETRIES=3
POWERBI_BATCH_SIZE=100

# Data Processing
MAX_DATA_ROWS=1000000
DATA_CHUNK_SIZE=10000
EXTRACT_TIMEOUT=3600
REFRESH_TIMEOUT=1800

# File Storage
TEMP_DIR=/tmp/bi-integration
MAX_FILE_SIZE_MB=500
CLEANUP_INTERVAL_HOURS=24

# Security
ENCRYPTION_KEY=your-encryption-key-here
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT=3600

# Background Jobs
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/5