# CSV Export Service Environment Configuration

# Basic Service Settings
DEBUG=false
API_PORT=8014
API_HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://csvservice:csvservice@localhost:5432/csvservice
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Authentication & Security
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CSV Generation Settings
CSV_OUTPUT_DIR=/tmp/csv-exports
CSV_TEMPLATE_DIR=app/templates
CSV_MAX_FILE_SIZE_MB=500
CSV_TIMEOUT_SECONDS=300
CSV_CONCURRENT_JOBS=10

# CSV Format Settings
CSV_DEFAULT_ENCODING=utf-8
CSV_DEFAULT_DELIMITER=,
CSV_DEFAULT_QUOTE_CHAR="
CSV_DEFAULT_ESCAPE_CHAR=\\
CSV_DEFAULT_LINE_TERMINATOR=\n
CSV_MAX_ROWS_PER_FILE=1000000
CSV_MAX_COLUMNS=1000

# Data Processing Settings
ENABLE_DATA_VALIDATION=true
ENABLE_DATA_TRANSFORMATION=true
ENABLE_LARGE_FILE_STREAMING=true
ENABLE_COMPRESSION=true

# Performance Settings
MAX_CONCURRENT_JOBS=15
JOB_QUEUE_SIZE=1000
WORKER_TIMEOUT=300
CHUNK_SIZE=10000
MEMORY_LIMIT_MB=1000

# Rate Limiting Settings
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# File Cleanup Settings
CLEANUP_OLDER_THAN_DAYS=7
CLEANUP_INTERVAL_HOURS=24

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# Compression Settings
ENABLE_GZIP_COMPRESSION=true
ENABLE_ZIP_COMPRESSION=true
COMPRESSION_LEVEL=6

# Security Settings
ENABLE_CONTENT_FILTERING=true
MAX_FIELD_LENGTH=32768

# Data Validation Settings
VALIDATE_ENCODING=true
VALIDATE_FIELD_TYPES=true
VALIDATE_FIELD_LENGTHS=true
HANDLE_NULL_VALUES=true
NULL_VALUE_REPLACEMENT=

# Advanced Features
ENABLE_CUSTOM_FORMATTERS=true
ENABLE_DATA_FILTERS=true
ENABLE_COLUMN_MAPPING=true
ENABLE_BATCH_PROCESSING=true

# Monitoring Settings
ENABLE_METRICS=true
METRICS_PORT=9014