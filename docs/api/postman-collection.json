              "raw": "{\n  \"query\": \"show me top 10 sources with most errors in the last 24 hours and create a bar chart\",\n  \"conversation_id\": \"test_conv_002\",\n  \"options\": {\n    \"include_visualization\": true,\n    \"max_results\": 10\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/nlp/process-query",
