# Production Environment Configuration
# ====================================
# This file contains production-specific settings
# IMPORTANT: Replace all placeholder values with actual production credentials

# Environment Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# Database Configuration (Production)
POSTGRES_HOST=prod-postgres.company.com
POSTGRES_PORT=5432
POSTGRES_DB=splunk_mcp_production
POSTGRES_USER=splunk_mcp_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PRODUCTION_PASSWORD
DATABASE_URL=postgresql://splunk_mcp_prod_user:CHANGE_THIS_SECURE_PRODUCTION_PASSWORD@prod-postgres.company.com:5432/splunk_mcp_production

# Redis Configuration (Production)
REDIS_HOST=prod-redis.company.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_SECURE_REDIS_PASSWORD
REDIS_DB=0
REDIS_URL=redis://:CHANGE_THIS_SECURE_REDIS_PASSWORD@prod-redis.company.com:6379/0

# JWT Configuration (Production)
JWT_SECRET_KEY=GENERATE_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_DAYS=30

# AI/ML API Keys (Production)
OPENAI_API_KEY=sk-PRODUCTION-OPENAI-API-KEY-HERE
ANTHROPIC_API_KEY=PRODUCTION-ANTHROPIC-API-KEY-HERE
OPENAI_MODEL=gpt-4
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Splunk Configuration (Production)
SPLUNK_HOST=splunk.company.com
SPLUNK_PORT=8089
SPLUNK_SCHEME=https
SPLUNK_USERNAME=splunk_mcp_service
SPLUNK_PASSWORD=PRODUCTION_SPLUNK_PASSWORD
SPLUNK_VERIFY_SSL=true
SPLUNK_DEFAULT_INDEX=main

# Service Ports (Production)
API_GATEWAY_PORT=8000
NLP_ENGINE_PORT=8001
VISUALIZATION_PORT=8002
ALERT_MANAGER_PORT=8003
FRONTEND_PORT=3000

# Integration Services (Production)
SLACK_BOT_TOKEN=xoxb-PRODUCTION-SLACK-BOT-TOKEN
SLACK_SIGNING_SECRET=PRODUCTION-SLACK-SIGNING-SECRET
SLACK_APP_TOKEN=xapp-PRODUCTION-SLACK-APP-TOKEN

TEAMS_APP_ID=PRODUCTION-TEAMS-APP-ID
TEAMS_APP_PASSWORD=PRODUCTION-TEAMS-APP-PASSWORD
TEAMS_TENANT_ID=PRODUCTION-TEAMS-TENANT-ID

# SMTP Configuration (Production)
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=noreply@company.com
SMTP_PASSWORD=PRODUCTION_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@company.com
SMTP_FROM_NAME=Splunk MCP Platform

# Security (Production)
CORS_ORIGINS=["https://company.com", "https://api.company.com"]
FORCE_HTTPS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=1000

# Performance (Production)
MAX_WORKERS=8
WORKER_CONNECTIONS=1000
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
REDIS_MAX_CONNECTIONS=100

# SSL Configuration (Production)
SSL_CERT_PATH=/etc/ssl/certs/production.crt
SSL_KEY_PATH=/etc/ssl/private/production.key

# Monitoring (Production)
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Logging (Production)
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/splunk-mcp/application.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10

# Backup Configuration (Production)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# AWS Configuration (for backups)
AWS_ACCESS_KEY_ID=PRODUCTION_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=PRODUCTION_AWS_SECRET_KEY
AWS_REGION=us-west-2
BACKUP_BUCKET=prod-splunk-mcp-backups

# Feature Flags (Production)
FEATURE_SLACK_INTEGRATION=true
FEATURE_TEAMS_INTEGRATION=true
FEATURE_EMAIL_INTEGRATION=true
FEATURE_BI_INTEGRATION=true
FEATURE_ADVANCED_ANALYTICS=true

# Experimental Features (Disabled in Production)
EXPERIMENTAL_AI_SUGGESTIONS=false
EXPERIMENTAL_VOICE_INTERFACE=false
EXPERIMENTAL_MOBILE_APP=false

# Application Metadata
APP_NAME=Splunk MCP Integration
APP_VERSION=1.0.0
APP_DESCRIPTION=Natural Language Interface for Splunk Enterprise

# Support Information
SUPPORT_EMAIL=support@company.com
SUPPORT_URL=https://support.company.com

# Kubernetes Configuration (if applicable)
K8S_NAMESPACE=splunk-mcp-prod

# Time Zone
TZ=UTC