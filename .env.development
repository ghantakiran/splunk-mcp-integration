# Development Environment Configuration
# =====================================
# This file contains development-specific settings
# Copy to .env for local development

# Environment Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Database Configuration (Local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=splunk_mcp_dev
POSTGRES_USER=splunk_mcp_user
POSTGRES_PASSWORD=dev_password_123
DATABASE_URL=postgresql://splunk_mcp_user:dev_password_123@localhost:5432/splunk_mcp_dev

# Redis Configuration (Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_123
REDIS_DB=0
REDIS_URL=redis://:dev_redis_123@localhost:6379/0

# JWT Configuration (Development)
JWT_SECRET_KEY=dev-jwt-secret-key-not-for-production-use-only
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# AI/ML API Keys (Development)
OPENAI_API_KEY=sk-dev-openai-api-key-here
ANTHROPIC_API_KEY=dev-anthropic-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Splunk Configuration (Development)
SPLUNK_HOST=dev-splunk.company.com
SPLUNK_PORT=8089
SPLUNK_SCHEME=https
SPLUNK_USERNAME=dev_splunk_user
SPLUNK_PASSWORD=dev_splunk_password
SPLUNK_VERIFY_SSL=false
SPLUNK_DEFAULT_INDEX=dev_main

# Service Ports (Development)
API_GATEWAY_PORT=8000
NLP_ENGINE_PORT=8001
VISUALIZATION_PORT=8002
ALERT_MANAGER_PORT=8003
FRONTEND_PORT=3000

# SMTP Configuration (Development - Using Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=dev@localhost

# Development Features
MOCK_EXTERNAL_APIS=true
ENABLE_SWAGGER_UI=true
ENABLE_DEBUG_TOOLBAR=true
RELOAD_ON_CHANGE=true
PROFILING_ENABLED=true

# Testing Configuration
TESTING=false
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/test_splunk_mcp

# Security (Relaxed for Development)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
FORCE_HTTPS=false
RATE_LIMIT_ENABLED=false

# Performance (Development)
MAX_WORKERS=2
DB_POOL_SIZE=5
REDIS_MAX_CONNECTIONS=10